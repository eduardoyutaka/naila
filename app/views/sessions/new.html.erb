<div class="flex min-h-screen" style="height: 100vh;">

  <%# Left decorative panel — hidden on mobile %>
  <div class="relative hidden lg:flex lg:w-5/12 flex-col items-center overflow-hidden bg-zinc-900 border-r border-white/10"
       style="height: 100%; background-image: radial-gradient(circle, #162d50 1px, transparent 1px); background-size: 28px 28px;">

    <%# Branding — centered, fills remaining height above footer %>
    <div class="flex-1 flex flex-col items-center justify-center">
      <div class="relative text-center px-10">

        <%# Logo — vertical imagotipo already includes the NAILA wordmark %>
        <div class="flex flex-col items-center mb-8">
          <%= image_tag "imagotipo-vertical-branco.png",
                alt: "Naila",
                class: "object-contain mb-3",
                style: "width: 200px; height: auto;" %>
          <div class="text-xs font-medium tracking-widest text-zinc-300 uppercase">Sistema de Gerenciamento de Riscos</div>
        </div>

        <%# Radar rings + center dot — anchored between the two texts %>
        <div class="relative flex items-center justify-center my-8">
          <div class="absolute rounded-full border border-sky-500/40"
               style="width: 160px; height: 160px; animation: ping-slow 3s ease-out infinite; animation-delay: 0s;"></div>
          <div class="absolute rounded-full border border-sky-500/30"
               style="width: 160px; height: 160px; animation: ping-slow 3s ease-out infinite; animation-delay: 1s;"></div>
          <div class="absolute rounded-full border border-sky-500/20"
               style="width: 160px; height: 160px; animation: ping-slow 3s ease-out infinite; animation-delay: 2s;"></div>
          <%# Center dot %>
          <div class="relative w-3 h-3 rounded-full bg-sky-500" style="box-shadow: 0 0 12px #0ea5e9, 0 0 24px #0ea5e980;"></div>
        </div>

        <p class="text-sm text-zinc-300 leading-relaxed max-w-sm">
          Monitoramento em tempo real de risco de enchentes para Curitiba e Região Metropolitana.
        </p>

      </div>
    </div>

    <%# Partner logos footer %>
    <div class="relative z-10 flex flex-col items-center gap-3 w-full" style="padding-bottom: 2rem;">
      <p class="text-sm font-semibold text-zinc-300 tracking-widest uppercase">Apoio</p>
      <div class="flex items-center justify-center gap-8 w-full">
        <%= image_tag "partners/anjo_inovador.png",
              alt: "Anjo Inovador",
              class: "object-contain opacity-90",
              style: "height: 72px; max-width: 240px; filter: brightness(0) invert(1);" %>
        <div class="h-12 w-px bg-white/10"></div>
        <%= image_tag "partners/seia.png",
              alt: "SEIA",
              class: "object-contain opacity-100",
              style: "height: 92px; max-width: 220px; filter: brightness(0) invert(1);" %>
      </div>
    </div>

  </div>

  <%# Right login panel %>
  <div class="flex flex-1 flex-col items-center justify-center px-6 py-12 lg:px-12 overflow-y-auto">

    <%# Mobile-only logo — vertical imagotipo already includes the NAILA wordmark %>
    <div class="mb-8 flex flex-col items-center lg:hidden">
      <%= image_tag "imagotipo-vertical-branco.png",
            alt: "Naila",
            class: "object-contain",
            style: "width: 110px; height: auto;" %>
    </div>

    <div class="w-full max-w-sm animate-fade-in">

      <%# Header %>
      <div class="mb-8">
        <h1 class="text-2xl font-semibold text-white">Acesso ao Painel</h1>
        <p class="mt-1.5 text-sm text-zinc-400">Sistema restrito a agentes autorizados</p>
      </div>

      <%# Flash messages %>
      <% if flash[:alert].present? %>
        <div class="mb-5 rounded-lg border border-risk-high/30 bg-risk-high/10 px-4 py-3 text-sm text-risk-high animate-fade-in">
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 flex-shrink-0">
              <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-8-5a.75.75 0 0 1 .75.75v4.5a.75.75 0 0 1-1.5 0v-4.5A.75.75 0 0 1 10 5Zm0 10a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
            </svg>
            <%= flash[:alert] %>
          </div>
        </div>
      <% end %>

      <% if flash[:notice].present? %>
        <div class="mb-5 rounded-lg border border-green-500/30 bg-green-500/10 px-4 py-3 text-sm text-green-400 animate-fade-in">
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 flex-shrink-0">
              <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
            </svg>
            <%= flash[:notice] %>
          </div>
        </div>
      <% end %>

      <%# Login form %>
      <%= form_with url: login_path, method: :post, class: "space-y-5" do |f| %>
        <div>
          <label for="email_address" class="mb-1.5 block text-sm font-medium text-zinc-400">Email</label>
          <input type="email" name="email_address" id="email_address" required autofocus
                 class="w-full rounded-lg border border-white/10 bg-zinc-800 px-3 py-2.5 text-white placeholder-zinc-400/50 outline-none transition-colors focus:border-sky-500 focus:ring-1 focus:ring-sky-500"
                 placeholder="seu@email.gov.br">
        </div>

        <div>
          <label for="password" class="mb-1.5 block text-sm font-medium text-zinc-400">Senha</label>
          <input type="password" name="password" id="password" required
                 class="w-full rounded-lg border border-white/10 bg-zinc-800 px-3 py-2.5 text-white placeholder-zinc-400/50 outline-none transition-colors focus:border-sky-500 focus:ring-1 focus:ring-sky-500"
                 placeholder="••••••••">
        </div>

        <button type="submit"
                class="w-full rounded-lg bg-sky-500 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-sky-500/90 focus:outline-none focus:ring-2 focus:ring-sky-500 focus:ring-offset-2 focus:ring-offset-zinc-950">
          Entrar
        </button>
      <% end %>

      <div class="mt-4 text-center">
        <%= link_to "Esqueceu sua senha?", new_password_reset_path,
              class: "text-xs text-zinc-400 hover:text-sky-500 transition-colors" %>
      </div>

    </div>

    <%# Footer %>
    <p class="mt-12 text-xs text-zinc-400/50">
      &copy; 2026 Defesa Civil de Curitiba &mdash; Uso restrito
    </p>

  </div>
</div>
