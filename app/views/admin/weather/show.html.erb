<% content_for(:title, "Naila — Meteorologia") %>
<% source_labels = { "open_weather_map" => "OpenWeatherMap", "open_meteo" => "Open-Meteo" } %>

<div class="mb-8">
  <%= catalyst_heading "Meteorologia", level: 1 %>
  <%= catalyst_text "Condições atuais e previsão de precipitação para Curitiba", class: "mt-1" %>
</div>

<%# ── Section 1: Data Source Health ── %>
<div class="mb-6 rounded-xl border border-zinc-950/10 dark:border-white/10 bg-white dark:bg-zinc-900" data-testid="data-source-health">
  <div class="border-b border-zinc-950/10 dark:border-white/10 px-4 py-3">
    <h2 class="text-lg font-semibold text-zinc-950 dark:text-white">Fontes de Dados</h2>
  </div>
  <% if @data_sources.any? %>
    <div class="grid grid-cols-1 gap-0 divide-y divide-zinc-950/10 dark:divide-white/10 sm:grid-cols-2 sm:divide-x sm:divide-y-0 lg:grid-cols-4 lg:divide-y-0">
      <% @data_sources.each do |source| %>
        <div class="px-4 py-4" data-testid="data-source-card">
          <div class="flex items-center justify-between">
            <span class="text-sm font-medium text-zinc-950 dark:text-white truncate"><%= source.name %></span>
            <% status_color = case source.status
                              when "active"   then "bg-sensor-online"
                              when "degraded" then "bg-risk-attention"
                              else "bg-risk-high"
                              end %>
            <span class="ml-2 flex-shrink-0 h-2 w-2 rounded-full <%= status_color %>"></span>
          </div>
          <% status_label = case source.status
                            when "active"   then "Online"
                            when "degraded" then "Degradado"
                            else "Offline"
                            end %>
          <div class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">
            <%= status_label %>
            <% if source.consecutive_failures > 0 %>
              · <%= source.consecutive_failures %> falha(s)
            <% end %>
          </div>
          <div class="mt-2 text-xs text-zinc-500 dark:text-zinc-400">
            <% if source.last_successful_fetch_at %>
              Última atualização: <%= time_ago_in_words(source.last_successful_fetch_at) %> atrás
            <% else %>
              Nunca atualizado
            <% end %>
          </div>
          <div class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">
            Intervalo: <%= (source.fetch_interval_seconds / 60.0).round %> min
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="px-4 py-8 text-center text-sm text-zinc-500 dark:text-zinc-400">
      Nenhuma fonte de dados configurada.
    </div>
  <% end %>
</div>

<%# ── Section 2: Current Conditions Banner ── %>
<div class="mb-6 rounded-xl border border-zinc-950/10 dark:border-white/10 bg-white dark:bg-zinc-900" data-testid="current-conditions">
  <div class="border-b border-zinc-950/10 dark:border-white/10 px-4 py-3">
    <h2 class="text-lg font-semibold text-zinc-950 dark:text-white">Condições Atuais</h2>
  </div>
  <% if @current_conditions %>
    <div class="grid grid-cols-2 gap-0 divide-x divide-zinc-950/10 dark:divide-white/10 sm:grid-cols-3 lg:grid-cols-6">
      <div class="px-4 py-4">
        <div class="text-xs font-semibold uppercase tracking-wider text-zinc-700 dark:text-zinc-300">Temperatura</div>
        <div class="mt-1.5 text-2xl font-semibold tabular-nums text-zinc-950 dark:text-white">
          <%= @current_conditions.temperature_c ? "#{number_with_precision(@current_conditions.temperature_c, precision: 1)}°C" : "—" %>
        </div>
      </div>
      <div class="px-4 py-4">
        <div class="text-xs font-semibold uppercase tracking-wider text-zinc-700 dark:text-zinc-300">Umidade</div>
        <div class="mt-1.5 text-2xl font-semibold tabular-nums text-zinc-950 dark:text-white">
          <%= @current_conditions.humidity_pct ? "#{number_with_precision(@current_conditions.humidity_pct, precision: 0)}%" : "—" %>
        </div>
      </div>
      <div class="px-4 py-4">
        <div class="text-xs font-semibold uppercase tracking-wider text-zinc-700 dark:text-zinc-300">Vento</div>
        <div class="mt-1.5 text-2xl font-semibold tabular-nums text-zinc-950 dark:text-white">
          <%= @current_conditions.wind_speed_ms ? "#{number_with_precision(@current_conditions.wind_speed_ms, precision: 1)} m/s" : "—" %>
        </div>
      </div>
      <div class="px-4 py-4">
        <div class="text-xs font-semibold uppercase tracking-wider text-zinc-700 dark:text-zinc-300">Pressão</div>
        <div class="mt-1.5 text-2xl font-semibold tabular-nums text-zinc-950 dark:text-white">
          <%= @current_conditions.pressure_hpa ? "#{number_with_precision(@current_conditions.pressure_hpa, precision: 0)} hPa" : "—" %>
        </div>
      </div>
      <div class="px-4 py-4">
        <div class="text-xs font-semibold uppercase tracking-wider text-zinc-700 dark:text-zinc-300">Precipitação</div>
        <div class="mt-1.5 text-2xl font-semibold tabular-nums text-zinc-950 dark:text-white">
          <%= @current_conditions.precipitation_mm ? "#{number_with_precision(@current_conditions.precipitation_mm, precision: 1)} mm" : "—" %>
        </div>
      </div>
      <div class="px-4 py-4">
        <div class="text-xs font-semibold uppercase tracking-wider text-zinc-700 dark:text-zinc-300">Condição</div>
        <div class="mt-1.5 text-sm font-medium text-zinc-950 dark:text-white capitalize">
          <%= @current_conditions.weather_condition.presence || "—" %>
        </div>
        <div class="mt-1 text-xs text-zinc-500 dark:text-zinc-400">
          <%= l(@current_conditions.observed_at, format: :short) %> · <%= source_labels[@current_conditions.source] || @current_conditions.source %>
        </div>
      </div>
    </div>
  <% else %>
    <div class="px-4 py-8 text-center text-sm text-zinc-500 dark:text-zinc-400">
      ☁️ Aguardando dados meteorológicos...
    </div>
  <% end %>
</div>

<%# ── Section 3: Precipitation Forecast ── %>
<%= turbo_frame_tag "weather_forecast" do %>
  <%
    grouped_forecasts = @forecasts_in_range.group_by(&:source)
    selected_chart_data = (grouped_forecasts[@forecast_source] || []).map do |f|
      {
        time: f.valid_from.strftime("%d/%m %H:%M"),
        precipitation_mm: f.precipitation_mm.to_f.round(1),
        probability: f.precipitation_probability.to_f.round(0)
      }
    end
    source_options = WeatherForecast::FORECAST_SOURCES.map { |key| [ source_labels[key] || key, key ] }
  %>
  <div class="mb-6 rounded-xl border border-zinc-950/10 dark:border-white/10 bg-white dark:bg-zinc-900">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-zinc-950/10 dark:border-white/10 px-4 py-3">
      <div>
        <h2 class="text-lg font-semibold text-zinc-950 dark:text-white">Previsão de Precipitação</h2>
        <p class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-400 tabular-nums">
          <%= l(@forecast_from, format: :short) %> → <%= l(@forecast_to, format: :short) %>
        </p>
      </div>
      <%= render "range_form", frame: "weather_forecast", scope: :forecast,
            from: @forecast_from, to: @forecast_to, min: @forecast_bounds[0], max: @forecast_bounds[1],
            source_param: "forecast_source", source_options: source_options, selected_source: @forecast_source %>
    </div>
    <% if selected_chart_data.any? %>
      <div class="p-4">
        <div data-testid="forecast-chart"
             data-controller="admin--forecast-chart"
             data-admin--forecast-chart-forecasts-value="<%= selected_chart_data.to_json %>"
             data-admin--forecast-chart-title-value="">
          <div data-admin--forecast-chart-target="chart" class="h-[320px] w-full relative">
            <div class="absolute inset-0 flex items-center justify-center pointer-events-none" data-forecast-fallback>
              <p class="text-sm text-zinc-500">Carregando previsão...</p>
            </div>
          </div>
        </div>
      </div>
    <% else %>
      <div class="px-4 py-8 text-center text-sm text-zinc-500 dark:text-zinc-400" data-testid="forecast-empty">
        Nenhuma previsão disponível para o período selecionado.
      </div>
    <% end %>
  </div>
<% end %>

<%# ── Section 4: Forecast vs Actual ── %>
<%= turbo_frame_tag "weather_comparison" do %>
  <div class="rounded-xl border border-zinc-950/10 dark:border-white/10 bg-white dark:bg-zinc-900">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-zinc-950/10 dark:border-white/10 px-4 py-3">
      <div>
        <h2 class="text-lg font-semibold text-zinc-950 dark:text-white">Previsão vs Observado</h2>
        <p class="mt-0.5 text-xs text-zinc-500 dark:text-zinc-400 tabular-nums">
          <%= l(@comparison_from, format: :short) %> → <%= l(@comparison_to, format: :short) %>
        </p>
      </div>
      <%= render "range_form", frame: "weather_comparison", scope: :comparison, from: @comparison_from, to: @comparison_to, min: @comparison_bounds[0], max: @comparison_bounds[1] %>
    </div>
    <% if @observations_in_range.any? || @comparison_forecasts.any? %>
      <%
        observed_series = @observations_in_range.map do |obs|
          [obs.observed_at.iso8601, obs.precipitation_mm.to_f.round(1)]
        end

        forecast_by_source = @comparison_forecasts.group_by(&:source).map do |source_key, forecasts|
          {
            name: source_labels[source_key] || source_key,
            data: forecasts.map { |f| [f.valid_from.iso8601, f.precipitation_mm.to_f.round(1)] },
            color: source_key == "open_weather_map" ? "#f59e0b" : "#8b5cf6"
          }
        end

        comparison_series = [
          { name: "Observado", data: observed_series, color: "#06b6d4" },
          *forecast_by_source
        ]
      %>
      <div data-controller="admin--timeseries"
           data-testid="comparison-chart"
           data-admin--timeseries-series-value="<%= comparison_series.to_json %>"
           data-admin--timeseries-unit-value="mm">
        <div data-admin--timeseries-target="chart" class="h-[280px] w-full px-2 pb-2"></div>
      </div>
    <% else %>
      <div class="px-4 py-8 text-center text-sm text-zinc-500 dark:text-zinc-400" data-testid="comparison-empty">
        Sem dados de comparação disponíveis para o período selecionado.
      </div>
    <% end %>
  </div>
<% end %>
