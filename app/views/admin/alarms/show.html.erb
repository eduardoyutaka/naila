<% content_for(:title, "Naila — #{@alarm.name}") %>

<%
  state_label = { "ok" => "OK", "alarm" => "Alarme", "insufficient_data" => "Dados Insuficientes" }
  state_color = { "ok" => "green", "alarm" => "red", "insufficient_data" => "zinc" }
  trigger_label = { "alarm" => "Alarme", "ok" => "OK", "insufficient_data" => "Dados Insuficientes" }
  missing_data_label = {
    "missing" => "Ausente", "notBreaching" => "Não viola",
    "breaching" => "Viola", "ignore" => "Ignorar"
  }
%>

<%# ── Back + Actions Header ── %>
<div class="mb-6 flex items-center gap-4">
  <%= catalyst_button_link "Alarmes", href: admin_alarms_path, variant: :plain do %>
    <svg data-slot="icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
    </svg>
    Voltar
  <% end %>
</div>

<%# ── Page Heading ── %>
<div class="mb-8">
  <div class="mb-2 flex flex-wrap items-center gap-2">
    <%= catalyst_badge state_label[@alarm.state], color: state_color[@alarm.state], data: { testid: "alarm-state" } %>
    <%= catalyst_badge "Métrica", color: "zinc" %>
    <% if @alarm.current_severity %>
      <%= severity_badge(@alarm.current_severity) %>
    <% end %>
    <% unless @alarm.enabled? %>
      <%= catalyst_badge "Desativado", color: "yellow" %>
    <% end %>
  </div>
  <%= catalyst_heading @alarm.name, level: 1 %>
  <% if @alarm.description.present? %>
    <%= catalyst_text @alarm.description, class: "mt-1" %>
  <% end %>
  <% if @alarm.state_reason.present? && !@alarm.ok? %>
    <p class="mt-1 text-xs text-zinc-500 dark:text-zinc-400"><%= @alarm.state_reason %></p>
  <% end %>
</div>

<div class="grid gap-6 lg:grid-cols-3">
  <%# ── Left Column ── %>
  <div class="lg:col-span-2 space-y-6">

    <%# Histórico do Métrico %>
    <div class="rounded-xl border border-white/10 bg-zinc-800/50" data-testid="alarm-history">
      <div class="flex items-center justify-between border-b border-white/10 px-6 py-4">
        <%= catalyst_subheading "Histórico do Métrico" %>
        <span class="text-xs text-zinc-500 dark:text-zinc-400">
          <%= @chart_readings.length %> períodos de <%= distance_of_time_in_words(@alarm.period_seconds) %>
        </span>
      </div>
      <% if @chart_readings.any? && @chart_readings.any? { |_, v| v.to_f.positive? } %>
        <div class="px-6 py-4"
             data-controller="admin--reading-chart"
             data-admin--reading-chart-readings-value="<%= @chart_readings.to_json %>"
             data-admin--reading-chart-unit-value="<%= @chart_unit %>"
             data-admin--reading-chart-chart-type-value="bar"
             data-admin--reading-chart-color-value="#0ea5e9"
             data-admin--reading-chart-thresholds-value="<%= @chart_thresholds.to_json %>">
          <div data-admin--reading-chart-target="chart" class="h-48 w-full"></div>
        </div>
      <% else %>
        <div class="px-6 py-8 text-center text-sm text-zinc-500 dark:text-zinc-400">
          Sem dados no período.
        </div>
      <% end %>
    </div>

    <%# Avaliação Atual %>
    <div class="rounded-xl border border-white/10 bg-zinc-800/50" data-testid="alarm-evaluation">
      <div class="flex items-center justify-between border-b border-white/10 px-6 py-4">
        <%= catalyst_subheading "Avaliação Atual" %>
        <% if @alarm.last_evaluated_at %>
          <span class="text-xs tabular-nums text-zinc-500 dark:text-zinc-400">
            há <%= time_ago_in_words(@alarm.last_evaluated_at) %>
          </span>
        <% end %>
      </div>
      <% if @alarm.last_datapoints.blank? %>
        <div class="px-6 py-8 text-center text-sm text-zinc-500 dark:text-zinc-400">
          Aguardando primeira avaliação.
        </div>
      <% else %>
        <div class="border-b border-white/10 px-6 py-3 text-xs text-zinc-400">
          Configurado: <strong class="text-zinc-200"><%= @alarm.datapoints_to_alarm %></strong> de
          <strong class="text-zinc-200"><%= @alarm.evaluation_periods %></strong> períodos para disparar
        </div>
        <div class="divide-y divide-white/10">
          <% @alarm.alarm_thresholds.order(:severity).each do |threshold| %>
            <% breaching_count = @alarm.last_datapoints.count { |dp| dp["breaching_severity"].to_i >= threshold.severity } %>
            <% triggered = breaching_count >= @alarm.datapoints_to_alarm %>
            <% progress = [ (breaching_count.to_f / @alarm.datapoints_to_alarm * 100).round, 100 ].min %>
            <div class="px-6 py-3" data-testid="alarm-evaluation-tier-<%= threshold.severity %>">
              <div class="mb-2 flex items-center justify-between gap-3">
                <div class="flex items-center gap-2">
                  <%= severity_badge(threshold.severity) %>
                  <span class="tabular-nums text-sm text-zinc-200">
                    <%= comparison_symbol(threshold.comparison_operator) %>
                    <%= threshold.threshold_value %><%= threshold.unit %>
                  </span>
                </div>
                <% if triggered %>
                  <span class="rounded-full bg-risk-emergency/20 px-2 py-0.5 text-xs font-semibold text-risk-emergency">
                    Disparado
                  </span>
                <% else %>
                  <span class="text-xs text-zinc-500 dark:text-zinc-400">
                    <%= breaching_count %> de <%= @alarm.datapoints_to_alarm %> períodos violaram
                  </span>
                <% end %>
              </div>
              <div class="h-1.5 w-full overflow-hidden rounded-full bg-zinc-700/50">
                <div class="h-full <%= triggered ? "bg-risk-emergency" : severity_bar_class(threshold.severity) %>"
                     style="width: <%= progress %>%"></div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# Pontos de Dados Coletados %>
    <% if @alarm.last_datapoints.present? %>
      <div class="rounded-xl border border-white/10 bg-zinc-800/50" data-testid="alarm-datapoints">
        <div class="border-b border-white/10 px-6 py-4">
          <%= catalyst_subheading "Pontos de Dados Coletados" %>
        </div>
        <div class="px-6 py-2">
          <%= catalyst_table do %>
            <%= catalyst_table_head do %>
              <%= catalyst_table_row do %>
                <%= catalyst_th "Período" %>
                <%= catalyst_th "Valor" %>
                <%= catalyst_th "Severidade Disparada" %>
              <% end %>
            <% end %>
            <%= catalyst_table_body do %>
              <% @alarm.last_datapoints.each do |dp| %>
                <%= catalyst_table_row do %>
                  <%= catalyst_td do %>
                    <span class="tabular-nums text-zinc-400">#<%= dp["period"] %></span>
                  <% end %>
                  <%= catalyst_td do %>
                    <% if dp["value"].nil? %>
                      <span class="text-zinc-500">—</span>
                    <% else %>
                      <span class="tabular-nums text-zinc-200">
                        <%= number_with_precision(dp["value"], precision: 2) %><%= @chart_unit %>
                      </span>
                    <% end %>
                  <% end %>
                  <%= catalyst_td do %>
                    <% if dp["breaching_severity"].nil? %>
                      <span class="text-xs text-zinc-500">Sem dados</span>
                    <% elsif dp["breaching_severity"].to_i.zero? %>
                      <span class="text-xs text-zinc-500">Nenhuma</span>
                    <% else %>
                      <%= severity_badge(dp["breaching_severity"]) %>
                    <% end %>
                  <% end %>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Configuration %>
    <div class="rounded-xl border border-white/10 bg-zinc-800/50" data-testid="alarm-config">
      <div class="border-b border-white/10 px-6 py-4">
        <%= catalyst_subheading "Configuração" %>
      </div>
      <%= catalyst_dl class: "px-6" do %>
        <%= catalyst_dt "Métrica" %><%= catalyst_dd @alarm.metric_name %>
        <%= catalyst_dt "Estatística" %><%= catalyst_dd @alarm.statistic %>
        <%= catalyst_dt "Período" %><%= catalyst_dd "#{@alarm.period_seconds}s" %>
        <%= catalyst_dt "Avaliação" %><%= catalyst_dd "#{@alarm.datapoints_to_alarm} de #{@alarm.evaluation_periods} períodos" %>
        <% if @alarm.alarm_thresholds.any? %>
          <%= catalyst_dt "Faixas de Limiar" %>
          <%= catalyst_dd do %>
            <div class="space-y-1">
              <% @alarm.alarm_thresholds.order(:severity).each do |t| %>
                <div class="flex items-center gap-2">
                  <%= severity_badge(t.severity) %>
                  <span class="tabular-nums text-xs text-zinc-500 dark:text-zinc-400">
                    <%= comparison_symbol(t.comparison_operator) %> <%= t.threshold_value %><%= t.unit %>
                  </span>
                </div>
              <% end %>
            </div>
          <% end %>
        <% end %>
        <%= catalyst_dt "Dados Ausentes" %><%= catalyst_dd(missing_data_label[@alarm.missing_data_treatment] || @alarm.missing_data_treatment) %>
        <%= catalyst_dt "Escopo" %><%= catalyst_dd(@alarm.river&.name || @alarm.river_basin&.name || "Global") %>
      <% end %>
    </div>

    <%# Ações Configuradas %>
    <div class="rounded-xl border border-white/10 bg-zinc-800/50" data-testid="alarm-actions">
      <div class="flex items-center justify-between border-b border-white/10 px-6 py-4">
        <%= catalyst_subheading "Ações Configuradas" %>
        <% if policy(AlarmAction).create? %>
          <%= catalyst_button_link href: new_admin_alarm_alarm_action_path(@alarm), color: "sky" do %>
            <svg data-slot="icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            Nova Ação
          <% end %>
        <% end %>
      </div>
      <% if @alarm_actions.empty? %>
        <div class="px-6 py-6 text-center">
          <%= catalyst_text "Nenhuma ação configurada." %>
        </div>
      <% else %>
        <div class="divide-y divide-white/10">
          <% @alarm_actions.each do |action| %>
            <div class="flex items-center justify-between px-6 py-3">
              <div class="flex flex-col gap-0.5">
                <div class="flex items-center gap-3">
                  <%= catalyst_badge trigger_label[action.trigger_state], color: state_color[action.trigger_state] || "zinc" %>
                  <span class="text-sm text-white">Notificação</span>
                  <% unless action.enabled? %>
                    <span class="text-xs text-zinc-500 dark:text-zinc-400">(desativada)</span>
                  <% end %>
                </div>
                <span class="text-xs text-zinc-500 dark:text-zinc-400">Notificação global</span>
              </div>
              <div class="flex items-center gap-1">
                <% if policy(action).update? %>
                  <%= link_to edit_admin_alarm_alarm_action_path(@alarm, action),
                        class: "rounded-md p-1.5 text-zinc-400 hover:bg-white/5 hover:text-sky-400 transition-colors",
                        aria: { label: "Editar ação #{trigger_label[action.trigger_state]}" } do %>
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
                    </svg>
                  <% end %>
                <% end %>
                <% if policy(action).destroy? %>
                  <%= button_to admin_alarm_alarm_action_path(@alarm, action),
                        method: :delete,
                        class: "rounded-md p-1.5 text-zinc-400 hover:bg-red-500/10 hover:text-red-400 transition-colors",
                        form: { data: { turbo_confirm: "Remover esta ação?" } },
                        aria: { label: "Remover ação #{trigger_label[action.trigger_state]}" } do %>
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                    </svg>
                  <% end %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <%# State History %>
    <% if @state_histories.any? %>
      <div class="rounded-xl border border-white/10 bg-zinc-800/50" data-testid="alarm-history">
        <div class="flex items-center justify-between border-b border-white/10 px-6 py-4">
          <%= catalyst_subheading "Histórico de Estados" %>
          <%= catalyst_text_link "Ver tudo", href: history_admin_alarm_path(@alarm) %>
        </div>
        <div class="divide-y divide-white/10">
          <% @state_histories.each do |history| %>
            <div class="px-6 py-3">
              <div class="flex items-center gap-2 mb-1">
                <%= catalyst_badge state_label[history.previous_state], color: state_color[history.previous_state] || "zinc" %>
                <svg class="h-3 w-3 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3" />
                </svg>
                <%= catalyst_badge state_label[history.new_state], color: state_color[history.new_state] || "zinc" %>
                <span class="ml-auto text-xs tabular-nums text-zinc-500 dark:text-zinc-400">
                  <%= l(history.evaluated_at, format: :short) %>
                </span>
              </div>
              <p class="text-xs text-zinc-500 dark:text-zinc-400"><%= history.reason %></p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>

  <%# ── Right Column ── %>
  <div class="space-y-6">

    <%# Gerenciar Alarme %>
    <div class="rounded-xl border border-white/10 bg-zinc-800/50">
      <div class="border-b border-white/10 px-6 py-4">
        <%= catalyst_subheading "Gerenciar" %>
      </div>
      <div class="p-4 space-y-2">
        <% if policy(@alarm).update? %>
          <%= catalyst_button_link "Editar Alarme", href: edit_admin_alarm_path(@alarm), variant: :outline, color: "zinc", class: "w-full justify-center" do %>
            <svg data-slot="icon" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L10.582 16.07a4.5 4.5 0 0 1-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 0 1 1.13-1.897l8.932-8.931Zm0 0L19.5 7.125" />
            </svg>
            Editar Alarme
          <% end %>
        <% end %>
        <% if policy(@alarm).update? && !@alarm.enabled? %>
          <%= button_to admin_alarm_status_path(@alarm), method: :patch, params: { enabled: "true" },
                class: "flex w-full items-center justify-center gap-2 rounded-lg border border-risk-normal/30 bg-risk-normal/10 px-4 py-2.5 text-sm font-medium text-risk-normal hover:bg-risk-normal/20 transition-colors" do %>
            Ativar Alarme
          <% end %>
        <% end %>
        <% if policy(@alarm).update? && @alarm.enabled? %>
          <%= button_to admin_alarm_status_path(@alarm), method: :patch, params: { enabled: "false" },
                class: "flex w-full items-center justify-center gap-2 rounded-lg border border-risk-attention/30 bg-risk-attention/10 px-4 py-2.5 text-sm font-medium text-risk-attention hover:bg-risk-attention/20 transition-colors" do %>
            Desativar Alarme
          <% end %>
        <% end %>
        <% if policy(@alarm).destroy? %>
          <%= catalyst_divider(soft: true) %>
          <%= button_to admin_alarm_path(@alarm), method: :delete,
                class: "flex w-full items-center justify-center gap-2 rounded-lg border border-red-500/30 bg-red-500/10 px-4 py-2.5 text-sm font-medium text-red-400 hover:bg-red-500/20 transition-colors",
                form: { data: { turbo_confirm: "Tem certeza que deseja remover este alarme? Esta ação não pode ser desfeita." } } do %>
            Remover Alarme
          <% end %>
        <% end %>
      </div>
    </div>

    <%# Informações %>
    <div class="rounded-xl border border-white/10 bg-zinc-800/50">
      <div class="border-b border-white/10 px-6 py-4">
        <%= catalyst_subheading "Informações" %>
      </div>
      <%= catalyst_dl class: "px-6" do %>
        <%= catalyst_dt "Última Avaliação" %>
        <%= catalyst_dd @alarm.last_evaluated_at ? l(@alarm.last_evaluated_at, format: :short) : "—" %>
        <%= catalyst_dt "Mudança de Estado" %>
        <%= catalyst_dd @alarm.state_changed_at ? l(@alarm.state_changed_at, format: :short) : "—" %>
        <%= catalyst_dt "Total de Transições" %>
        <%= catalyst_dd @alarm.alarm_state_histories.count.to_s %>
        <%= catalyst_dt "Criado em" %>
        <%= catalyst_dd @alarm.created_at.strftime("%d/%m/%Y") %>
      <% end %>
    </div>

    <%# Notificações %>
    <div class="rounded-xl border border-white/10 bg-zinc-800/50" data-testid="alarm-notifications">
      <div class="border-b border-white/10 px-6 py-4">
        <%= catalyst_subheading "Notificações" %>
      </div>
      <div class="space-y-3 p-6">
        <% if @alarm.current_severity.blank? %>
          <p class="text-sm text-zinc-500 dark:text-zinc-400">
            Alarme em estado OK — nenhuma notificação será disparada até que a severidade seja atingida.
          </p>
        <% elsif @notification_preview.fires_any? %>
          <div class="flex items-center gap-2">
            <span class="text-sm text-zinc-300">Severidade atual</span>
            <%= severity_badge(@alarm.current_severity) %>
            <span class="text-sm text-zinc-300">dispara <strong class="text-white"><%= @notification_preview.rule_count %></strong> regra(s).</span>
          </div>
          <ul class="space-y-1 text-sm text-zinc-300">
            <li class="flex items-center gap-2">
              <svg class="h-4 w-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75" />
              </svg>
              Email: <strong class="text-white"><%= @notification_preview.email_recipient_count %></strong>
              <%= @notification_preview.email_recipient_count == 1 ? "usuário" : "usuários" %>
            </li>
            <li class="flex items-center gap-2">
              <svg class="h-4 w-4 text-zinc-400" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" />
              </svg>
              SMS: <strong class="text-white"><%= @notification_preview.sms_recipient_count %></strong>
              <%= @notification_preview.sms_recipient_count == 1 ? "usuário" : "usuários" %>
            </li>
          </ul>
        <% else %>
          <div class="flex items-center gap-2">
            <span class="text-sm text-zinc-300">Severidade atual</span>
            <%= severity_badge(@alarm.current_severity) %>
            <span class="text-sm text-zinc-300">não dispara nenhuma regra.</span>
          </div>
        <% end %>
        <%= catalyst_text_link "Ver regras globais", href: admin_notification_rules_path, class: "text-sm" %>
      </div>
    </div>

  </div>
</div>
